# ============================================================
# API Token Relay Platform — 环境变量配置
# 复制此文件为 .env 并填入真实值
# ============================================================

# 应用密钥（用于 JWT 签名和 Fernet 加密，请使用 `openssl rand -hex 32` 生成）
SECRET_KEY=change-me-to-a-random-secret-key

# 数据库（SQLite 默认，生产环境改用 PostgreSQL）
DATABASE_URL=sqlite:///./data/relay_platform.db

# Redis（可选，不设置则使用内存限流）
# REDIS_URL=redis://localhost:6379/0

# 厂商 API Keys（平台管理员的密钥，将加密存储）
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx

# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# 限流默认配置
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_TOKENS_PER_MONTH=1000000
